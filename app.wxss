page {
  background: #f2f3f5;
  color: #1a1a1a;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.wrap {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  color: #666;
}

.field-value {
  color: #1a1a1a;
  text-align: right;
  max-width: 60%;
}

.required {
  color: #fa5151;
  margin-right: 6rpx;
}

.btn {
  display: block;
  width: 100%;
  margin-top: 20rpx;
  background: #07c160;
  color: #fff;
  border-radius: 14rpx;
  font-size: 30rpx;
  line-height: 84rpx;
  text-align: center;
  border: none;
}

.btn::after {
  border: none;
}

.btn-ghost {
  background: #f2f3f5;
  color: #333;
}

.btn-danger {
  background: #fa5151;
}

.btn-disabled {
  background: #c9c9c9;
}

.row {
  display: flex;
  gap: 16rpx;
}

.row .btn {
  flex: 1;
}

.hint {
  color: #8a8f99;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 12rpx;
}

.mono {
  font-family: Consolas, Menlo, monospace;
}

.input {
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  background: #fff;
}

.field .input {
  flex: 1;
  margin-left: 20rpx;
}

.ok {
  color: #07c160;
}

.fail {
  color: #fa5151;
}

.result-box {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #f7f8fa;
  font-size: 26rpx;
  line-height: 1.7;
  word-break: break-all;
}

.code-big {
  font-size: 84rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
  color: #07c160;
  text-align: center;
  padding: 20rpx 0;
}

.code-sub {
  text-align: center;
  color: #8a8f99;
  font-size: 24rpx;
}

.case {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.case:last-child {
  border-bottom: none;
}

.case-name {
  flex: 1;
  padding-right: 16rpx;
  line-height: 1.5;
}

.case-btn {
  width: 150rpx;
  margin: 0;
  line-height: 64rpx;
  font-size: 26rpx;
}

.case-result {
  font-size: 22rpx;
  line-height: 1.5;
  color: #666;
  padding: 8rpx 0 12rpx;
  word-break: break-all;
}

.list-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 24rpx;
}

.list-row .c1 { width: 120rpx; color: #666; }
.list-row .c2 { flex: 1; }
.list-row .c3 { width: 100rpx; text-align: right; }
